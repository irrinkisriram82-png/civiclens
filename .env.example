# AI provider. Use ONE key. Free option: get a Gemini key at https://aistudio.google.com/apikey
# Without any key the app uses a labelled offline fallback (weak: ignores photos).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Paid option (Anthropic):
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Optional: force a provider (gemini or anthropic). Default: auto-detect from which key is set.
AI_PROVIDER=
PORT=3000
# Map centre for your town (default: Palasa-Kasibugga) and how far from it reports are accepted.
MAP_LAT=18.7625
MAP_LNG=84.4195
SERVICE_RADIUS_KM=50
# Accounts are created on first run. CHANGE these before any public deployment.
OFFICER_EMAIL=officer@civiclens.demo
OFFICER_PASSWORD=Officer@123
ADMIN_EMAIL=admin@civiclens.demo
ADMIN_PASSWORD=Admin@123
# Optional: fixed secret for session tokens (auto-generated and saved in data/.secret if empty).
SESSION_SECRET=
# Optional: where data is stored (use a persistent disk in production).
DATA_DIR=
